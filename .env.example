# PostHog client analytics (public configuration values).
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional search ownership verification tokens (not required to run the site).
# Copy only the content value of the verification meta tag, not the full HTML.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Waitlist storage (server-only; never prefix the key with NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# X conversion tracking (server-only). Generate token in X Ads Manager.
X_PIXEL_TOKEN=
# Set only after choosing the confirmed waitlist signup event in Events Manager.
# Format: tw-rhsuk-xxxxx
X_WAITLIST_EVENT_ID=
